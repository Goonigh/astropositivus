---
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../ui/ServiceCard.astro";
import Section from "./Section.astro";

import c1 from "../../assets/pics/card-pic1.png";
import c2 from "../../assets/pics/card-pic2.png";
import c3 from "../../assets/pics/card-pic3.png";
import c4 from "../../assets/pics/card-pic4.png";
import c5 from "../../assets/pics/card-pic5.png";
import c6 from "../../assets/pics/card-pic6.png";

const cards = [
  {
    index: 1,
    titleTop: "AI Team Training",
    titleBottom: "Upskilling workforces for the generative era.",
    img: c1,
    alt: "AI Team Training",
    link: "#contact",
  },
  {
    index: 2,
    titleTop: "AI App Building",
    titleBottom: "Custom LLM-powered applications.",
    img: c2,
    alt: "AI App Building",
    link: "#contact",
  },
  {
    index: 3,
    titleTop: "AI Governance",
    titleBottom: "Ethical frameworks and risk management.",
    img: c3,
    alt: "AI Governance",
    link: "#contact",
  },
  {
    index: 1,
    titleTop: "AI Agents",
    titleBottom: "Autonomous workflows for business ops.",
    img: c4,
    alt: "AI Agents",
    link: "#contact",
  },
  {
    index: 2,
    titleTop: "Strategic Roadmap",
    titleBottom: "Long-term AI integration planning.",
    img: c5,
    alt: "Strategic Roadmap",
    link: "#contact",
  },
  {
    index: 3,
    titleTop: "Data Readiness",
    titleBottom: "Preparing infrastructure for AI scale.",
    img: c6,
    alt: "Data Readiness",
    link: "#contact",
  },
];

const description =
  "We help you navigate the AI landscape with clarity and confidence. Our services include";
---

<Section id="services">
  <div class="mt-[140px] mb-5">
    <SectionTitle sectionTitle="Services" description={description} />
    <div class="grid lg:grid-cols-2 lg:grid-rows-3 gap-10">
      {
        cards.map((card) => (
          <ServiceCard
            index={card.index}
            titleTop={card.titleTop}
            titleBottom={card.titleBottom}
            img={card.img}
            alt={card.alt}
            link={card.link}
          />
        ))
      }
    </div>
  </div>
</Section>
